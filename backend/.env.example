NODE_ENV=production
# Most cloud hosts provide PORT automatically. Leave it unset there.
MONITOR_BACKEND_PORT=4015
TOOWIX_MEET_URL=https://talk.toowix.com
TELEMETRY_INTERVAL_MS=3000
METRICS_RETENTION_MINUTES=30
ENABLE_LIVE_MODE=true
MONITOR_ADMIN_TOKEN=replace-with-a-strong-admin-secret
TELEMETRY_INGEST_TOKEN=replace-with-a-different-strong-ingestion-secret
CORS_ORIGIN=https://YOUR-VERCEL-PROJECT.vercel.app,https://talk.toowix.com
# Create an Upstash Redis database and add these server-only credentials.
# Vercel's Upstash integration may instead supply KV_REST_API_URL and KV_REST_API_TOKEN.
UPSTASH_REDIS_REST_URL=https://YOUR-REDIS-ENDPOINT.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-your-upstash-rest-token
